{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm hook exec '{{if eq (commandName .Input.ToolInput.GetValue.Command) \"gofmt\"}}false{{else}}true{{end}}' '{{if not .Success}}{{permission \"deny\" \"Do not run gofmt (or go fmt). Let golangci-lint fmt hook handle formatting.\"}}{{end}}'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm hook exec --ft go 'golangci-lint fmt {{quoteJoin .Files}}'",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm hook exec --ft go 'golangci-lint run {{quote (dirname .File)}}'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
