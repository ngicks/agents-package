FROM docker.io/library/golang:1.25-bookworm

ARG HTTPS_PROXY=http://build-bot:S3cretPassw0rd@proxy.corp.example:3128
ENV HTTPS_PROXY=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTPS_PROXY}

COPY corp-ca.pem /usr/local/share/ca-certificates/corp-ca.crt
RUN update-ca-certificates

WORKDIR /src
COPY . .
RUN go generate ./... && \
    go build -o /app .

ENTRYPOINT ["/app"]
