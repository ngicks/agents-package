{
  "version": 1,
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm hook exec 'true' '{{permissionAllow}}'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
